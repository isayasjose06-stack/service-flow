# =============================================================================
# ServiceFlow — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file with real secrets.
# =============================================================================

# ── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# ── Database (PostgreSQL + PostGIS) ──────────────────────────────────────────
DATABASE_URL=postgresql://serviceflow:serviceflow_dev@localhost:5432/serviceflow?schema=public

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# ── Google OAuth (Fase 3) ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ── Object Storage (MinIO / S3) ─────────────────────────────────────────────
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=serviceflow

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@serviceflow.com

# ── Platform Config Defaults ─────────────────────────────────────────────────
# These are also stored in the PlatformConfig table (Fase 2 seed).
# Env vars here are used as fallback if DB config is not available.
DEFAULT_REQUEST_EXPIRY_HOURS=24
DEFAULT_MATCH_RESPONSE_HOURS=2
DEFAULT_MAX_TECHNICIANS_PER_REQUEST=20
